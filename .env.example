APP_NAME=OpsDeck
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8007

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# 本番ではLOG_STACK=daily / LOG_LEVEL=warning / LOG_DAILY_DAYS=30以上を推奨
LOG_DAILY_DAYS=14
# Optional remote TLS logging destination and bounded socket timeouts.
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_PAPERTRAIL_CONNECTION_TIMEOUT_SECONDS=3
LOG_PAPERTRAIL_WRITE_TIMEOUT_SECONDS=3

DB_CONNECTION=sqlite
# MySQLを使う場合はDB_CONNECTION=mysqlへ変更し、次の値を有効にします。rootではなくアプリ専用ユーザーを設定します。
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=opsdeck
# DB_USERNAME=opsdeck_app
# DB_PASSWORD=
# Remote MySQL/MariaDB requires a trusted CA file; certificate verification is enabled when this is set.
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 本番のHTTPS公開環境でのみ設定します。HTTPの開発環境では有効にしないでください。
# APP_ENV=production
# APP_URL=https://your-company.example
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Cloudflare R2用。R2接続環境だけ設定し、実値はシークレット管理へ保存します。公開URLは設定しません。
# OPSDECK_STORAGE_*はAPP_ENV=productionのときだけ本番用ディスクに読み込みます。本番キーを開発PCへコピーしないでください。
# 本番起動時の誤接続防止用。OPSDECK_STORAGE_BUCKETと同じ本番バケット名を設定します。
OPSDECK_STORAGE_EXPECTED_PRODUCTION_BUCKET=opsdeck-prod-files
OPSDECK_STORAGE_EXPECTED_DEVELOPMENT_BUCKET=opsdeck-dev-files
OPSDECK_STORAGE_DRIVER=s3
OPSDECK_STORAGE_KEY=
OPSDECK_STORAGE_SECRET=
OPSDECK_STORAGE_REGION=auto
OPSDECK_STORAGE_BUCKET=
OPSDECK_STORAGE_ENDPOINT=
OPSDECK_STORAGE_PATH_STYLE=true
# 非本番R2テスト用。opsdeck_objectsとは別の非公開バケット・別APIキーを使います。
# 通常の開発ではOPSDECK_EVIDENCE_DISK / OPSDECK_IMPORT_DISKをlocalのままにしてください。
# テストバケットを実際に使う場合だけ、両方をopsdeck_objects_testへ一時的に切り替えます。
OPSDECK_TEST_STORAGE_DRIVER=s3
OPSDECK_TEST_STORAGE_KEY=
OPSDECK_TEST_STORAGE_SECRET=
OPSDECK_TEST_STORAGE_REGION=auto
OPSDECK_TEST_STORAGE_BUCKET=
OPSDECK_TEST_STORAGE_ENDPOINT=
OPSDECK_TEST_STORAGE_PATH_STYLE=true
# 旧名（OPSDECK_OBJECT_STORAGE_*）も後方互換のため読み込みます。新旧両方ある場合はOPSDECK_STORAGE_*を優先します。
OPSDECK_OBJECT_STORAGE_KEY=
OPSDECK_OBJECT_STORAGE_SECRET=
OPSDECK_OBJECT_STORAGE_REGION=
OPSDECK_OBJECT_STORAGE_BUCKET=
OPSDECK_OBJECT_STORAGE_ENDPOINT=
OPSDECK_OBJECT_STORAGE_PATH_STYLE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
BEANSTALKD_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local log transport suppresses mail without writing recipients or message contents to logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Privileged; inject into the one-off deployment-check process only. Do not store in .env or config cache.
RESEND_DOMAIN_CHECK_API_KEY=
# Resend SMTP (smtp.resend.com / resend / MAIL_PASSWORD) automatically uses its idempotent API transport.
# Set true only to force the Resend API transport with a non-standard MAIL_* configuration.
RESEND_IDEMPOTENT_MAIL_ENABLED=false
RESEND_API_TIMEOUT=10
MAIL_DELIVERY_JOB_BACKOFF_SECONDS=30,120
MAIL_FROM_ADDRESS="info@kimegami.jp"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpsDeck application settings
# Comma-separated addresses receive server error alerts and have platform admin access.
OPSDECK_PLATFORM_ADMIN_EMAILS=
# Comma-separated trusted reverse-proxy IPs/CIDRs. Set only the actual proxy addresses; wildcards are rejected.
OPSDECK_TRUSTED_PROXIES=
OPSDECK_SERVER_ERROR_ALERT_COOLDOWN_SECONDS=300
OPSDECK_SECURITY_HSTS_MAX_AGE_SECONDS=31536000
# Optional. Leave blank to use the absolute, non-public storage/app/backups directory.
OPSDECK_BACKUP_PATH=
# Backup files are plaintext by default, per the release decision. Set true only when encryption is explicitly enabled.
OPSDECK_BACKUP_ENCRYPTION_ENABLED=false
# Used only when backup encryption is enabled; keep old encrypted-backup keys for restoring those generations.
# Plaintext backup manifests are authenticated with APP_KEY, which must remain recoverable with the backup set.
OPSDECK_BACKUP_ENCRYPTION_KEY=
# OpsDeck 1.0 backups stay on the local server; do not configure an R2 backup copy.
OPSDECK_BACKUP_REMOTE_ENABLED=false
# The following legacy settings are retained for regression tests only. Do not change them for 1.0.
OPSDECK_BACKUP_REMOTE_DISK=opsdeck_backups
OPSDECK_BACKUP_REMOTE_PREFIX=opsdeck/backups
OPSDECK_BACKUP_REMOTE_RETENTION_DAYS=
# No backup storage credentials are needed for local-only backups; leave these blank.
OPSDECK_BACKUP_STORAGE_DRIVER=s3
OPSDECK_BACKUP_STORAGE_KEY=
OPSDECK_BACKUP_STORAGE_SECRET=
OPSDECK_BACKUP_STORAGE_REGION=auto
OPSDECK_BACKUP_STORAGE_BUCKET=
OPSDECK_BACKUP_STORAGE_ENDPOINT=
OPSDECK_BACKUP_STORAGE_PATH_STYLE=true
# Keep verified local backup generations for this many days. Older generations are removed only
# after a newer complete backup succeeds; generations created before this policy version are retained.
OPSDECK_BACKUP_LOCAL_RETENTION_DAYS=30
OPSDECK_BACKUP_SCHEDULE_TIME="02:00"
# Weekly backup restore verification time (Monday, application timezone).
OPSDECK_BACKUP_RESTORE_TEST_SCHEDULE_TIME="03:00"
OPSDECK_BACKUP_RESTORE_TEST_MAX_AGE_DAYS=10
OPSDECK_BACKUP_MAX_AGE_HOURS=26
# Maximum wall-clock time for database backup and restore subprocesses.
OPSDECK_DATABASE_PROCESS_TIMEOUT_SECONDS=3600
# Optional directory containing mysqldump or mariadb-dump when it is not on PATH.
OPSDECK_DATABASE_DUMP_DIRECTORY=
# Provision a separate empty MySQL/MariaDB database named opsdeck_restore_test_<environment>.
# Use a dedicated account with privileges only on that database; never point it at the application database.
# For remote restore targets, set a trusted CA file so server-certificate verification remains enabled.
OPSDECK_BACKUP_RESTORE_CONNECTION=backup_restore
OPSDECK_BACKUP_RESTORE_DB_DRIVER=mysql
OPSDECK_BACKUP_RESTORE_DB_HOST=
OPSDECK_BACKUP_RESTORE_DB_PORT=3306
OPSDECK_BACKUP_RESTORE_DB_DATABASE=
OPSDECK_BACKUP_RESTORE_DB_USERNAME=
OPSDECK_BACKUP_RESTORE_DB_PASSWORD=
OPSDECK_BACKUP_RESTORE_DB_SOCKET=
OPSDECK_BACKUP_RESTORE_DB_SSL_CA=
OPSDECK_ADMIN_MAIL_FROM_ADDRESS="info@kimegami.jp"
# CONTACT_TO_ADDRESS is the primary support inbox setting; OPSDECK_SUPPORT_EMAIL is a compatibility fallback.
OPSDECK_SUPPORT_EMAIL="support@kimegami.jp"
CONTACT_TO_ADDRESS="support@kimegami.jp"
OPSDECK_DEFAULT_TIMEZONE=UTC
OPSDECK_DEFAULT_BILLING_STATUS=inactive
OPSDECK_DEFAULT_CURRENCY=JPY
# 短時間の連続アップロードを抑えます。長期的な保存容量上限の代わりにはなりません。
OPSDECK_FILE_UPLOADS_PER_MEMBER_PER_MINUTE=5
OPSDECK_FILE_UPLOADS_PER_ORGANIZATION_PER_MINUTE=20
# 会社単位の合計保存量。値はMiB（1MiB = 1,048,576バイト）で扱い、短時間の回数制限とは別に適用されます。
OPSDECK_STORAGE_QUOTA_FREE_MB=100
OPSDECK_STORAGE_QUOTA_PREMIUM_MB=2048
# 本番R2上のOpsDeckファイル合計に対するアプリ側上限。50GiB = 51200MiB。VPS・ローカルバックアップの容量とは別です。
OPSDECK_PLATFORM_STORAGE_LIMIT_MIB=51200
# 1社あたりの追加容量上限。全体上限50GiBからPremium基本枠2GiBを差し引いた最大値です。
OPSDECK_STORAGE_ADDON_MAX_GIB=48
OPSDECK_STORAGE_QUOTA_LOCK_SECONDS=180
OPSDECK_STORAGE_QUOTA_LOCK_WAIT_SECONDS=15
OPSDECK_DEMO_SAVINGS_ORGANIZATION_ID=
OPSDECK_EMAIL_VERIFICATION_RESEND_ATTEMPTS_PER_MINUTE=3
OPSDECK_MAX_LOGIN_ATTEMPTS=5
OPSDECK_LOGIN_DECAY_SECONDS=60
# AI列マッピングは初期状態で無効です。有効化する前に外部送信範囲・為替・公式料金を確認してください。
OPSDECK_AI_ENABLED=false
OPSDECK_AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
OPSDECK_AI_TIMEOUT_SECONDS=15
OPSDECK_AI_REASONING_EFFORT=none
OPSDECK_AI_ESCALATION_ENABLED=true
OPSDECK_AI_ESCALATION_REASONING_EFFORT=medium
OPSDECK_AI_MAX_OUTPUT_TOKENS=1200
AI_MODEL_FAST=gpt-6-luna
AI_MODEL_STANDARD=gpt-6.1-sol
AI_MODEL_DEEP=gpt-6.1-sol
OPSDECK_AI_USD_TO_JPY_RATE=
OPSDECK_AI_PREMIUM_MONTHLY_BUDGET_JPY=500
# Keep model IDs and per-million-token prices aligned with current official pricing: https://platform.openai.com/pricing
OPSDECK_AI_MODEL_PRICES_PER_MILLION_TOKENS='{"gpt-6-luna":{"input":0.10,"cached_input":0.01,"cache_write_input":0.125,"output":0.50},"gpt-6.1-sol":{"input":2.00,"cached_input":0.10,"cache_write_input":2.50,"output":10.00}}'
OPSDECK_AI_BUDGET_RESERVATION_TTL_MINUTES=2
OPSDECK_AI_ESTIMATED_INPUT_OVERHEAD_TOKENS=4096
OPSDECK_AI_INPUT_TOKEN_ESTIMATE_MULTIPLIER=4
OPSDECK_AI_MAPPING_SUGGESTIONS_MAX_ATTEMPTS=5
OPSDECK_AI_MAPPING_SUGGESTION_DECAY_SECONDS=60
OPSDECK_AI_MAPPING_REASON_MAX_LENGTH=160
OPSDECK_SELLER_NAME=
OPSDECK_SELLER_ADDRESS=
OPSDECK_SELLER_PHONE=
OPSDECK_SELLER_REPRESENTATIVE=
OPSDECK_SUPPORT_SUBMISSION_LIMIT=5
OPSDECK_SUPPORT_SUBMISSION_DECAY_MINUTES=10
OPSDECK_LEGAL_LAST_UPDATED="2026年9月27日"
OPSDECK_PRIVACY_POLICY_LAST_UPDATED="2026年10月16日"
OPSDECK_DEFAULT_PLAN_CODE=free
OPSDECK_BILLING_PAST_DUE_GRACE_DAYS=7
OPSDECK_BILLING_CHECKOUT_ATTEMPTS_PER_MINUTE=3
OPSDECK_BILLING_PORTAL_ATTEMPTS_PER_MINUTE=3
OPSDECK_REFERRAL_REDIRECT_ATTEMPTS_PER_MINUTE=60
# 将来機能。OpsDeck 1.0では公開しません。1GiBごとに月額100円（税別）の設定は公開判断後に有効化します。
OPSDECK_RELEASE_STORAGE_ADDON=false
# 1.0公開対象外の機能。
OPSDECK_RELEASE_GOOGLE_SHEETS=false
OPSDECK_RELEASE_IMPACT_REPORT=false
OPSDECK_RELEASE_QUESTIONNAIRE_AI_DRAFT=false
OPSDECK_RELEASE_REFERRALS=false
OPSDECK_RELEASE_WORK_TIME_TRACKING=false
OPSDECK_WEEKLY_SUMMARY_PERIOD_DAYS=7
OPSDECK_INVITATION_EXPIRY_DAYS=7
OPSDECK_INVITATION_CREATE_ATTEMPTS_PER_MINUTE=5
OPSDECK_INVITATION_ACCEPT_ATTEMPTS_PER_MINUTE=5
OPSDECK_NAME_MAX_LENGTH=255
OPSDECK_COMPANY_SIZE_MAXIMUM=1000000
OPSDECK_PAGINATION_PER_PAGE=25
OPSDECK_SLUG_SUFFIX_LENGTH=8
# 開発・テストはlocalのままにします。本番でR2を使う場合は両方をopsdeck_objectsにします。
OPSDECK_EVIDENCE_DISK=local
OPSDECK_EVIDENCE_MAX_SIZE_KILOBYTES=10240
OPSDECK_EVIDENCE_DESCRIPTION_MAX_LENGTH=2000
OPSDECK_IMPORT_DISK=local
# 既存Importのsource_storage_diskが空の場合に参照する旧保存先。移行後も旧ファイルを残す間は変更しないでください。
OPSDECK_LEGACY_IMPORT_DISK=local
OPSDECK_IMPORT_MAX_SIZE_KILOBYTES=5120
OPSDECK_IMPORT_ASYNC_THRESHOLD_ROWS=500
OPSDECK_IMPORT_MAX_ROWS=20000
OPSDECK_IMPORT_NORMALIZATION_SAMPLE_ROWS=100
OPSDECK_IMPORT_VALUE_MAPPING_MAX_ENTRIES=100
OPSDECK_IMPORT_VALUE_MAPPING_MAX_VALUE_LENGTH=255
OPSDECK_IMPORT_MAX_HEADER_ROW_NUMBER=100
OPSDECK_IMPORT_MAX_SOURCE_ROW_NUMBER=20000
OPSDECK_IMPORT_PREVIEW_INSERT_CHUNK_SIZE=500
OPSDECK_GOOGLE_SHEETS_READ_CHUNK_ROWS=1000
OPSDECK_IMPORT_JOB_TIMEOUT_SECONDS=300
OPSDECK_IMPORT_STALE_AFTER_MINUTES=10
OPSDECK_XLSX_MAX_UNCOMPRESSED_XML_KILOBYTES=16384
OPSDECK_XLSX_MAX_ARCHIVE_ENTRIES=2000
OPSDECK_XLSX_MAX_ROWS=20000
OPSDECK_XLSX_MAX_COLUMNS=512
OPSDECK_XLSX_MAX_CELLS=50000
OPSDECK_QUEUE_STALE_AFTER_MINUTES=10
OPSDECK_QUEUE_WORKER_HEARTBEAT_INTERVAL_SECONDS=60
OPSDECK_QUEUE_WORKER_HEARTBEAT_RETENTION_DAYS=30
OPSDECK_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=5
OPSDECK_STRIPE_WEBHOOK_STALE_AFTER_MINUTES=5
OPSDECK_IMPACT_SNAPSHOT_DAILY_RETENTION_DAYS=365
# Cost savings estimate assumptions (not guaranteed savings)
OPSDECK_SAVINGS_RENEWAL_NEGOTIATION_RATE=0.10
OPSDECK_SAVINGS_UNUSED_ASSET_MONTHLY_JPY=5000
# Organization plan limits (adjust per deployment policy)
OPSDECK_LIMIT_EMPLOYEES=200
OPSDECK_LIMIT_ASSETS=500
OPSDECK_LIMIT_SAAS_SERVICES=100
OPSDECK_LIMIT_ADMINISTRATORS=5
OPSDECK_LIMIT_WARNING_PERCENTAGE=80

# Stripe Billing (secrets must be supplied outside source control)
STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_STORAGE_ADDON_GIB=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_TIMEOUT_SECONDS=3
STRIPE_TIMEOUT_SECONDS=10
STRIPE_WEBHOOK_LOCK_SECONDS=30
STRIPE_WEBHOOK_LOCK_WAIT_SECONDS=15
STRIPE_WEBHOOK_JOB_TRIES=5
STRIPE_WEBHOOK_JOB_TIMEOUT_SECONDS=30
STRIPE_WEBHOOK_JOB_UNIQUE_SECONDS=900
STRIPE_WEBHOOK_JOB_BACKOFF_SECONDS=5,15,60
